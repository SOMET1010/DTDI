{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pass-academy-story-contract-v1.schema.json",
  "title": "PASS Academy Story Contract V1",
  "type": "object",
  "required": ["id", "version", "character", "skill", "priority", "zeroReading", "scenes", "evidence", "impact"],
  "properties": {
    "id": {"type":"string","pattern":"^[a-z0-9-]+$"},
    "version": {"const":"1.0"},
    "character": {"type":"string","minLength":1},
    "skill": {"type":"string","minLength":1},
    "priority": {"enum":["P0","P1","P2"]},
    "zeroReading": {"const":true},
    "offlineRequired": {"type":"boolean","default":true},
    "estimatedMinutes": {"type":"number","minimum":1,"maximum":5},
    "scenes": {
      "type":"array","minItems":3,"maxItems":8,
      "items": {
        "type":"object",
        "required":["id","type","voice","visual"],
        "properties": {
          "id":{"type":"string","minLength":1},
          "type":{"enum":["situation","problem","choice","practice","rule","real-action","success"]},
          "voice":{"type":"string","minLength":1},
          "visual":{"type":"string","minLength":1,"description":"Reference to final illustration/scene asset, not an emoji placeholder."},
          "action":{"enum":["next","choice","practice","launch-real-action","finish"]},
          "choices": {
            "type":"array","minItems":2,"maxItems":3,
            "items": {
              "type":"object",
              "required":["id","visual","previewVoice","correct"],
              "properties": {
                "id":{"type":"string"},
                "visual":{"type":"string","minLength":1},
                "previewVoice":{"type":"string","minLength":1},
                "correct":{"type":"boolean"},
                "feedbackVoice":{"type":"string","minLength":1}
              },
              "additionalProperties":false
            }
          }
        },
        "allOf":[{"if":{"properties":{"type":{"const":"choice"}}},"then":{"required":["choices"]}}],
        "additionalProperties":false
      }
    },
    "realAction": {
      "type":"object",
      "required":["mode","safe"],
      "properties": {
        "mode":{"enum":["camera","dialer","settings","external-service","simulation-only","none"]},
        "safe":{"type":"boolean"},
        "description":{"type":"string"},
        "successSignal":{"type":"string"}
      },
      "additionalProperties":false
    },
    "evidence": {
      "type":"object",
      "required":["understood","practiced","performed"],
      "properties": {
        "understood":{"type":"boolean"},
        "practiced":{"type":"boolean"},
        "performed":{"type":"boolean"}
      },
      "additionalProperties":false
    },
    "impact": {
      "type":"object",
      "required":["baseline","immediate","retention"],
      "properties": {
        "baseline":{"type":"string","minLength":1},
        "immediate":{"type":"string","minLength":1},
        "retention":{"type":"string","minLength":1}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties":false
}